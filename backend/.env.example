# Copie este arquivo para .env e preencha os valores

# URL de conexão com o banco PostgreSQL (gerada pelo Railway)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Chave secreta para gerar tokens JWT (use qualquer texto longo e aleatório)
JWT_SECRET=troque_isso_por_um_texto_secreto_longo

# Porta do servidor (Railway define automaticamente)
PORT=3001

# ── Dados externos (rotina de importação) ─────────────────────────
# TheSportsDB: chave pública gratuita "123" (não precisa de cadastro)
THESPORTSDB_KEY=123
# 1 = importa ao subir o servidor e depois a cada IMPORT_INTERVALO_H horas
IMPORT_AUTO=1
IMPORT_INTERVALO_H=24
IMPORT_COMPETICOES=capixabao,serieD
IMPORT_TEMPORADA=2026
# API-Football (opcional, precisa de conta grátis em dashboard.api-football.com)
API_FOOTBALL_KEY=

# Em produção, restringe o CORS ao endereço do site
CORS_ORIGIN=
